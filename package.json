{
  "name": "pisoflow",
  "version": "0.1.0",
  "description": "A Pi skill for interactive Isoflow architecture explanations",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Max Sumrall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxsumrall/pisoflow.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "architecture",
    "isoflow",
    "pi-package",
    "visualization"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "build": "vite build",
    "render": "node skills/pisoflow/scripts/render.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "isoflow": "1.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-quill": "file:vendor/react-quill",
    "zod": "3.25.76"
  },
  "overrides": {
    "react-quill": "$react-quill",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "uuid": "14.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
