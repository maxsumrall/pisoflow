    },
    {
      "id": "processor",
      "name": "Order processor",
      "icon": "function-module",
      "description": "Consumes order events, coordinates payment, and writes the next order state."
    },
    {
      "id": "response",
      "name": "Order response",
      "icon": "document",
      "description": "Returns the order identifier and current status."
    }
